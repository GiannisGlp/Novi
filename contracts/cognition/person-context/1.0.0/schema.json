{
  "$defs": {
    "PrivacyClassificationModel": {
      "additionalProperties": false,
      "description": "Privacy classification for a contract/field (canonical registry semantics).",
      "properties": {
        "classification": {
          "default": "inherited",
          "enum": [
            "none",
            "inherited",
            "field-classified",
            "required",
            "sensitive-biometric"
          ],
          "title": "Classification",
          "type": "string"
        },
        "sensitive_fields": {
          "items": {
            "type": "string"
          },
          "title": "Sensitive Fields",
          "type": "array"
        },
        "retention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention"
        }
      },
      "title": "PrivacyClassificationModel",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Provenance chain for a derived object (doc 26 \u00a718).\n\nEvery derived object must be traceable: source \u2192 observation \u2192 evidence \u2192\nderived object. For model-derived results, model ID/version/runtime must be\nrecorded.",
      "properties": {
        "source": {
          "default": "system",
          "title": "Source",
          "type": "string"
        },
        "source_observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Observation Ids",
          "type": "array"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "source_object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Object Ids",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "model_runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Runtime"
        },
        "transformation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "SchemaVersion": {
      "additionalProperties": false,
      "description": "SemVer version of a contract schema (doc 26 \u00a722).",
      "properties": {
        "major": {
          "minimum": 0,
          "title": "Major",
          "type": "integer"
        },
        "minor": {
          "minimum": 0,
          "title": "Minor",
          "type": "integer"
        },
        "patch": {
          "minimum": 0,
          "title": "Patch",
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor",
        "patch"
      ],
      "title": "SchemaVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Current person-specific context, not a complete profile (doc 26 \u00a713).",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "contract_type": {
      "default": "PersonContext",
      "title": "Contract Type",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "person_ref": {
      "title": "Person Ref",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "presence_confidence": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Presence Confidence",
      "type": "number"
    },
    "identity_confidence": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Identity Confidence",
      "type": "number"
    },
    "attention_cues": {
      "items": {
        "type": "string"
      },
      "title": "Attention Cues",
      "type": "array"
    },
    "speech_cues": {
      "items": {
        "type": "string"
      },
      "title": "Speech Cues",
      "type": "array"
    },
    "addressee_cues": {
      "items": {
        "type": "string"
      },
      "title": "Addressee Cues",
      "type": "array"
    },
    "relationship_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relationship Category"
    },
    "relationship_confidence": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Relationship Confidence",
      "type": "number"
    },
    "authorized_interaction": {
      "default": false,
      "title": "Authorized Interaction",
      "type": "boolean"
    },
    "current_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Context"
    },
    "source_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Evidence Ids",
      "type": "array"
    },
    "source": {
      "default": "cognition",
      "title": "Source",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyClassificationModel"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    }
  },
  "required": [
    "id",
    "person_ref",
    "created_at"
  ],
  "title": "PersonContext",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novi.person-context/1.0.0"
}
