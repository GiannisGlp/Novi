coverage.xml
htmlcov/

# Local environment/configuration
.env
.env.*
!.env.example
.DS_Store

# Novi durable SQLite stores (runtime artifacts)
*.db
*.db-shm
*.db-wal

# Generated contract fixtures (regenerated by novi/contracts/tests/generate_fixtures.py)
