.dsh/
skills-lock.json
brain_evidence.json

# Novi canonical DB: runtime state stays unversioned, but keep the dir tracked
!novi/data/
novi/data/*
!novi/data/README.md

# Novi web UI (React/Vite) — build artifacts and deps
novi/web/ui/node_modules/
novi/web/ui/dist/
novi/web/ui/tsconfig*.tsbuildinfo

# Graphify
graphify-out/*
.hf-cache/
.airllm-models/

